# --- MLflow ---
# Tracking URI. Uses a local SQLite backend by default (works offline).
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_EXPERIMENT_NAME=Supply_Chain_Imbalanced_Predictor

# --- SAP AI Core (mocked; no real credentials required) ---
SAP_AI_CORE_SCENARIO=supply-chain-risk-optimizer
SAP_AI_CORE_EXECUTABLE=stockout-predictor
SAP_AI_CORE_RESOURCE_GROUP=default

# --- Agent LLM ---
# Offline mock is the default. Set to "mock" to run without any network/keys.
LLM_PROVIDER=mock

# --- Deployment ---
PORT=8080
